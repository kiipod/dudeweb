APP_NAME=dudeweb
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bot.dudeweb.xyz
TELEGRAM_WEBHOOK_DOMAIN=bot.dudeweb.xyz
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU
APP_MAINTENANCE_DRIVER=file
FILESYSTEM_DISK=public
BCRYPT_ROUNDS=12
CACHE_STORE=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
