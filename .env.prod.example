DB_PASSWORD=password
PGPASSWORD=verysecret
DB_TZ=Europe/Moscow

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

MOONSHINE_TITLE='dudeweb'

REMNAWAVE_API_URL=https://go.dudeweb.xyz
