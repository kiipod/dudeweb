{
    "log": {
        "error": "/var/log/remnanode/error.log",
        "access": "/var/log/remnanode/access.log",
        "loglevel": "warning"
    },
    "inbounds": [
        {
            "tag": "VLESS_RU_IN",
            "port": 443,
            "listen": "0.0.0.0",
            "protocol": "vless",
            "settings": {
                "clients": [],
                "decryption": "none"
            },
            "sniffing": {
                "enabled": true,
                "destOverride": [
                    "http",
                    "tls",
                    "quic"
                ]
            },
            "streamSettings": {
                "network": "raw",
                "security": "reality",
                "realitySettings": {
                    "show": false,
                    "xver": 0,
                    "target": "game.dudeweb.xyz:443",
                    "shortIds": [
                        ""
                    ],
                    "privateKey": "yBACUh0yHdanii-w5X3OSCaISSlF9OKT3tZOS_Xlo2k", // PrivateKey команды xray x25519 RU-ноды
                    "serverNames": [
                        "game.dudeweb.xyz"
                    ]
                }
            }
        }
    ],
    "outbounds": [
        {
            "tag": "DIRECT",
            "protocol": "freedom"
        },
        {
            "tag": "BLOCK",
            "protocol": "blackhole"
        },
        {
            "tag": "VLESS_DE_OUT",
            "protocol": "vless",
            "settings": {
                "id": "6ed62bca-2005-4b12-be7d-42fb4aa365bd", // VLESS ID пользователя bridge, который подключен к обоим сквадам (RU,DE)
                "flow": "xtls-rprx-vision",
                "port": 443,
                "address": "de.dudeweb.xyz",
                "encryption": "none"
            },
            "streamSettings": {
                "network": "raw",
                "security": "reality",
                "realitySettings": {
                    "password": "LeNNW5OBygoDgggpGcOaxyetk5LHlE5ikzTJumnigkY", // Password ключа DE-ноды
                    "serverName": "game.dudeweb.xyz"
                }
            }
        }
    ],
    "routing": {
        "rules": [
            {
                "ip": [
                    "ext:geoip.dat:private"
                ],
                "outboundTag": "BLOCK"
            },
            {
                "ip": [
                    "ext:geoip.dat:whitelist"
                ],
                "outboundTag": "DIRECT"
            },
            {
                "ip": [
                    "ext:geoip.dat:direct"
                ],
                "outboundTag": "DIRECT"
            },
            {
                "domain": [
                    "ext:geosite.dat:private"
                ],
                "outboundTag": "BLOCK"
            },
            {
                "domain": [
                    "ext:geosite.dat:category-ads",
                    "ext:geosite.dat:win-spy",
                    "ext:geosite.dat:torrent"
                ],
                "outboundTag": "BLOCK"
            },
            {
                "domain": [
                    "ext:geosite.dat:whitelist",
                    "ext:geosite.dat:apple",
                    "ext:geosite.dat:category-ru",
                    "ext:geosite.dat:microsoft",
                    "ext:geosite.dat:epicgames",
                    "ext:geosite.dat:google-play",
                    "ext:geosite.dat:pinterest",
                    "ext:geosite.dat:riot",
                    "ext:geosite.dat:steam",
                    "ext:geosite.dat:twitch",
                    "ext:geosite.dat:youtube",
                    "ext:geosite.dat:escapefromtarkov",
                    "ext:geosite.dat:faceit",
                    "ext:geosite.dat:origin"
